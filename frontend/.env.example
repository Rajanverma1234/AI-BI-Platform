# Frontend-only overrides for `npm run dev`. Copy to .env.local.
# Everything here is compiled into the bundle and visible to users - no secrets.
#
# Production values do NOT belong in this directory: the deployed bundle is
# built by the host, so set them in Vercel -> Project Settings -> Environment
# Variables (scoped to Production AND Preview). A production build with
# VITE_API_BASE_URL unset now fails instead of quietly falling back to
# localhost - see the guard in vite.config.ts.

VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION_PREFIX=/api/v1
VITE_APP_NAME=AI BI Platform

# Per-request timeout in milliseconds. The default (45000) is sized for a host
# that scales to zero and needs ~30s to answer its first request; drop it to
# something like 10000 when the API is always warm.
# VITE_API_TIMEOUT_MS=45000
