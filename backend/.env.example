# Backend-only overrides for running uvicorn outside docker. Copy to .env.
# The root .env.example is the reference for the full stack.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

POSTGRES_USER=aibi
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aibi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ORIGINS=http://localhost:5173

AI_PROVIDER=null
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
