# Backend-only overrides for running uvicorn outside docker. Copy to .env.
# The root .env.example is the reference for the full stack.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

POSTGRES_USER=aibi
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aibi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ORIGINS=http://localhost:5173

# Required in production; a marked insecure placeholder is used elsewhere.
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./var/storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_DATASET_EXTENSIONS=csv,xlsx

AI_PROVIDER=null
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
