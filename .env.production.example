# Production environment template.
#
#   cp .env.production.example .env.production
#   # fill in every REQUIRED value below
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# .env.production is git-ignored. Placeholders only in this file - never a real
# credential. Prefer your platform's secret manager over a file on disk; every
# value here can be injected as an ordinary environment variable instead.

# --- Application -------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# Single-line JSON, so a log shipper can parse it.
LOG_JSON=true

# --- PostgreSQL (REQUIRED) ---------------------------------------------------
# The API refuses to start in production with a default password.
POSTGRES_USER=aibi_prod
POSTGRES_PASSWORD=REQUIRED-generate-a-strong-password
POSTGRES_DB=aibi
# Or supply a complete URL instead of the three values above:
# DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/aibi
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Authentication (REQUIRED) -----------------------------------------------
# Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REQUIRED-generate-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_PARALLELISM=4

# --- CORS (REQUIRED) ---------------------------------------------------------
# Exact frontend origin(s), https only. "*" is rejected at startup.
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

# Optional, additive. For hosts whose name is not known until deploy time -
# chiefly Vercel preview deployments, which get a fresh hostname on every push
# and would otherwise fail the preflight with a 400 carrying no
# Access-Control-Allow-Origin. Full-matched against the Origin header.
#
# Include your team/project slug. Stopping at `.vercel\.app$` would let ANY
# Vercel project make credentialed requests to this API; start-up rejects a
# pattern broad enough to match unrelated origins.
# CORS_ORIGIN_REGEX=^https://myproject-[a-z0-9]+-myteam\.vercel\.app$

# --- HTTP hardening ----------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
# Enable once HTTPS terminates in front of the API.
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=63072000
MAX_REQUEST_BODY_MB=64

# --- Web server --------------------------------------------------------------
# Uvicorn worker processes. Each keeps its own rate-limit counters, so the
# effective RATE_LIMIT_* ceiling is per worker: with 4 workers a 10/min budget
# admits up to 40/min in aggregate. Set to 1 if you need the configured limits
# to be exact, and scale out with replicas behind a load balancer instead.
UVICORN_WORKERS=4

# The image's entrypoint runs `alembic upgrade head` before starting uvicorn,
# so a platform that just runs the container (Render, Fly, Cloud Run) gets its
# schema without a separate release step. Set to false where a dedicated job
# owns migrations - docker-compose.prod.yml does exactly that with its one-shot
# `migrate` service, and several replicas starting at once should not race for
# Alembic's lock.
RUN_MIGRATIONS=true

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_HEAVY_PER_MINUTE=30

# --- Storage -----------------------------------------------------------------
STORAGE_PROVIDER=local
# Inside the container; backed by the dataset_storage volume. Back it up.
STORAGE_LOCAL_ROOT=/app/var/storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_DATASET_EXTENSIONS=csv,xlsx

# --- AI providers ------------------------------------------------------------
# "null" ships a stub: every AI feature degrades to deterministic output.
AI_PROVIDER=null
# AI_MODEL=claude-sonnet-5
AI_REQUEST_TIMEOUT=60
# Server-side only. Never exposed to the browser, never logged.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Frontend (REQUIRED, build-time) -----------------------------------------
# Compiled into the bundle and visible to every user - no secrets here ever.
# Changing these needs a frontend rebuild, not a restart.
VITE_API_BASE_URL=https://api.example.com
VITE_API_VERSION_PREFIX=/api/v1
VITE_APP_NAME=AI BI Platform
