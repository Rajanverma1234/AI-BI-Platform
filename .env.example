# Copy to .env and adjust. NEVER commit a real .env - it is git-ignored.
# This file is consumed by docker compose and by the backend when run locally.

# --- Application -------------------------------------------------------------
PROJECT_NAME=AI BI Platform
ENVIRONMENT=development           # development | test | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                    # true emits single-line JSON logs

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=aibi
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aibi
# Host as seen by the backend. Use "db" under docker compose, "localhost" otherwise.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional full override; wins over the discrete values above.
# DATABASE_URL=postgresql+asyncpg://aibi:change-me-locally@localhost:5432/aibi
DB_ECHO=false

# Host port that maps to the container's 5432 (avoids clashing with a local server).
POSTGRES_HOST_PORT=5432

# --- Authentication ----------------------------------------------------------
# REQUIRED in production - the app refuses to start without it. Outside
# production an obvious insecure placeholder is used instead.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Argon2id cost parameters (raise on stronger hardware).
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_PARALLELISM=4

# --- Dataset uploads and storage ---------------------------------------------
# Storage backend for uploaded dataset files. "local" writes to the filesystem;
# an S3-compatible provider can be added without touching dataset logic.
STORAGE_PROVIDER=local
# Root directory for the local provider (git-ignored; bind-mounted in Docker).
STORAGE_LOCAL_ROOT=./var/storage

# Upload ceiling in megabytes; enforced while streaming, never hard-coded.
MAX_UPLOAD_SIZE_MB=50
# Comma-separated or a JSON array.
ALLOWED_DATASET_EXTENSIONS=csv,xlsx

# Rows sampled to infer column types, and rows per chunk when counting CSV rows.
DATASET_TYPE_SAMPLE_ROWS=1000
DATASET_CSV_CHUNK_ROWS=50000

# --- CORS --------------------------------------------------------------------
# Comma-separated or a JSON array.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- AI providers ------------------------------------------------------------
# "null" is an offline stub - the platform boots with no credentials at all.
AI_PROVIDER=null                  # null | anthropic
# AI_MODEL=claude-sonnet-5
AI_REQUEST_TIMEOUT=60

# Secrets: leave blank here and set them in your own .env or secret manager.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Frontend (build-time, exposed to the browser - no secrets) ---------------
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION_PREFIX=/api/v1
VITE_APP_NAME=AI BI Platform
